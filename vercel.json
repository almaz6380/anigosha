{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(get|app|download)",
      "destination": "/get.html"
    },
    {
      "source": "/tiktok-fertig",
      "destination": "/tiktok-fertig.html"
    },
    {
      "source": "/((?!assets/|favicon|icons|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
